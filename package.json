{
  "name": "d3-curve-circlecorners",
  "version": "0.1.10",
  "description": "A curve function that can be passed to the d3.js line.curve and area.curve functions",
  "main": "dist/d3-curve-circlecorners.min.js",
  "unpkg": "dist/d3-curve-circlecorners.min.js",
  "jsdelivr": "dist/d3-curve-circlecorners.min.js",
  "module": "dist/d3-curve-circlecorners.min.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carpiediem/d3-curve-circlecorners.git"
  },
  "scripts": {
    "build": "rollup -c",
    "pretest": "npm run build",
    "test": "tape ./src/**/*.spec.js",
    "test:coverage": "c8 npm test",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10",
    "@rollup/plugin-terser": "^1.0.0",
    "c8": "12",
    "d3-shape": "^3.2.0",
    "eslint": "10",
    "globals": "17",
    "prettier": "3",
    "rollup": "4",
    "tape": "5"
  },
  "sideEffects": false,
  "keywords": [
    "d3",
    "d3-shape",
    "curve",
    "rounded corners",
    "circle corners",
    "arc corners"
  ],
  "author": {
    "name": "Ryan SL Carpenter"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carpiediem/d3-curve-circlecorners/issues"
  },
  "homepage": "https://github.com/carpiediem/d3-curve-circlecorners#readme"
}
